# ==============================================================================
# BLINK EVM SNIPER SUITE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the app:
# cp .env.example .env
# ==============================================================================

# Master password for AES-256 local wallet encryption
VAULT_PASSWORD=your_secure_vault_password_here

# ------------------------------------------------------------------------------
# RPC & WebSocket Endpoints (Replace with Alchemy / QuickNode for 22ms latency)
# ------------------------------------------------------------------------------
RPC_BASE=https://mainnet.base.org
RPC_BASE_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
RPC_ETHEREUM_WS=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_INK=https://rpc-gel.inkonchain.com
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_ARC=https://mainnet.base.org
RPC_BASE_SEPOLIA=https://sepolia.base.org

# ------------------------------------------------------------------------------
# Telegram Bot Integration (Optional - for remote bot commands & live alerts)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_telegram_numeric_chat_id

# ------------------------------------------------------------------------------
# Block Explorer & Contract ABI Verification APIs (Optional)
# ------------------------------------------------------------------------------
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# ------------------------------------------------------------------------------
# NFT Floor & Portfolio Indexing (Optional - for NFT Tracker screen)
# ------------------------------------------------------------------------------
RESERVOIR_API_KEY=your_reservoir_api_key
ALCHEMY_NFT_API_KEY=your_alchemy_api_key
